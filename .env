# Environment Configuration for Project Compass
DEBUG=True
SECRET_KEY=django-insecure-compass-development-secret-key-3.10-5.0
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration:
# Set USE_POSTGRESQL=True to connect to a PostgreSQL instance.
# Defaults to SQLite (db.sqlite3) for instant zero-dependency local verification.
USE_POSTGRESQL=False
POSTGRES_DB=compass_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Celery & Redis
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Ollama LLM Engine (Self-Hosted Qwen 2.5)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b


# Embedding & Reranker Local Models
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_MIN_SCORE_THRESHOLD=0.25
RERANKER_TOP_N=3


# Storage paths for FAISS & BM25 indexes
FAISS_INDEX_DIR=data/faiss_indexes
BM25_INDEX_DIR=data/bm25_indexes
